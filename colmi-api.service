[Unit]
Description=Colmi Ring HTTP API (read-only, reads SQLite written by colmi-poller.service)
After=network.target colmi-poller.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/code/colmi-api
EnvironmentFile=/home/pi/code/colmi-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/code/colmi-api/.venv/bin/python app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
