# Colmi Ring BLE address (required)
# Find with: colmi_r02_client scan
COLMI_ADDRESS=XX:XX:XX:XX:XX:XX

# Full path to colmi_r02_client binary
COLMI_BIN=/home/pi/.local/bin/colmi_r02_client

# HTTP server port (default 8080)
PORT=8080

# CLI timeout per command in seconds (default 45)
COLMI_TIMEOUT=45

# Poller: seconds between poll cycles when someone's actually looking at the
# data (default 60)
POLL_INTERVAL_SEC=60

# Idle backoff: if no real caller (Evelyn/BOT — the watchdog's own checks
# don't count) has fetched a reading in this many seconds, drop to
# POLL_INTERVAL_BACKOFF_SEC to save the ring's battery. Clears immediately
# (within one 5s tick) the moment a real query comes in. Default 90min.
IDLE_BACKOFF_SEC=5400

# Poll interval while idle-backed-off. Default 30min.
POLL_INTERVAL_BACKOFF_SEC=1800

# API: a reading older than this many seconds is reported as stale.
# Set generously (2100s/35min) to comfortably cover both a slow cycle
# (actual cycle time regularly runs longer than POLL_INTERVAL_SEC due to BLE
# read timeouts — see ROADMAP.md) AND a full POLL_INTERVAL_BACKOFF_SEC idle
# gap.
STALE_AFTER_SEC=2100
